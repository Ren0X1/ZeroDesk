# --- Casa Ortega ---------------------------------------------------------
CO_USER=tu_email@ejemplo.com
CO_PASS=tu_password
# Importe de cada recarga (entre 6.99 y 40)
CO_AMOUNT=10
# Tarjeta Pluxee
CO_CARD=4111111111111111
CO_EXP=12/29
CO_CVV=123

# --- Avisos por Telegram -------------------------------------------------
# TG_TOKEN lo da @BotFather al crear el bot.
TG_TOKEN=123456789:AAExampleExampleExampleExampleExample
# TG_CHAT_ID lo saca "python sacar_chat_id.py" despues de escribirle al bot.
TG_CHAT_ID=

# --- Opciones ------------------------------------------------------------
# Sin ventana. Por defecto: si en la Pi, no en Windows.
#CO_HEADLESS=true
# Chromium a usar. En la Pi, el del sistema.
#CO_CHROMIUM=/usr/bin/chromium
# Bloquear imagenes/video/tipografias para gastar menos RAM (por defecto si).
#CO_BLOQUEAR_RECURSOS=true
# Hacerlo todo menos pulsar Pagar (no cobra). Tambien vale --simular.
#CO_SIMULAR=false
# Volcar gateway.json de la pasarela.
#CO_DEBUG=false
